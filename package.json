{
  "name": "voice-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "node scripts/serve.mjs build",
    "start": "node scripts/serve.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs",
    "format": "prettier --write app src scripts tests *.ts *.mjs",
    "format:check": "prettier --check app src scripts tests *.ts *.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.70",
    "@ai-sdk/mistral": "4.0.43",
    "@ai-sdk/provider-utils": "5.0.40",
    "@libsql/client": "0.18.0",
    "ai": "7.0.101",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
